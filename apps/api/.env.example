# -----------------------------------------------------------------------------
# apps/api environment variables (local development)
#
# Copy this file to apps/api/.env:
#   cp apps/api/.env.example apps/api/.env
#
# Loaded by @nestjs/config's ConfigModule at Nest boot (cwd = apps/api when
# run via `pnpm --filter api ...`), and by apps/api/drizzle.config.ts for
# `pnpm --filter api db:generate` / `db:migrate`.
#
# LOCAL DEVELOPMENT ONLY — placeholder/dev-only credentials. Keep in sync
# with the root .env's MIGRATOR_PASSWORD / APP_USER_PASSWORD, which is what
# actually provisions these two Postgres roles (see
# docker/postgres/init/01-roles.sh and AUTHENTICATION_PRD.md §5 Layer 3).
# -----------------------------------------------------------------------------

# HTTP port the Nest app listens on.
PORT=4000

# Runtime DB connection used by the NestJS app (DrizzleModule / DRIZZLE
# provider). Connects as `app_user`: NOBYPASSRLS, owns no tables — so
# Row-Level Security policies added in a later card (1.10) cannot be
# bypassed by the running API, even though it's the connection actually
# executing tenant queries.
DATABASE_URL=postgresql://app_user:app_user_dev_only@localhost:5432/wiseonline

# TLS for the DB connection. Off for the local loopback Docker container.
# Set to `true` in any non-local/managed-Postgres environment to require a
# verified TLS connection (the runtime pool sets ssl.rejectUnauthorized).
# The connection string's own sslmode is still honored.
DATABASE_SSL=false

# Migration-only DB connection used exclusively by
# `pnpm --filter api db:generate` and `pnpm --filter api db:migrate`
# (drizzle-kit). Connects as `migrator`, which owns the `public` schema and
# every table it creates. Never used by the running API — do not wire this
# into DrizzleModule/DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://migrator:migrator_dev_only@localhost:5432/wiseonline
