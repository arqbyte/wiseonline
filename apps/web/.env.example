# -----------------------------------------------------------------------------
# apps/web environment variables (local development)
#
# Copy this file to apps/web/.env.local:
#   cp apps/web/.env.example apps/web/.env.local
# -----------------------------------------------------------------------------

# Origin of the NestJS API this app proxies /api/* to (next.config.ts
# `rewrites`). Deliberately NOT prefixed with NEXT_PUBLIC_ — the rewrite is
# resolved on the Next.js server only, never shipped to the browser, which is
# what keeps the Better Auth session cookie same-origin (PRD §2.2).
API_ORIGIN=http://localhost:4000
