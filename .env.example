# -----------------------------------------------------------------------------
# Root environment variables — consumed by `docker-compose.yml` to bootstrap
# the local Postgres container (see docker/postgres/init/01-roles.sh).
#
# Copy this file to `.env` at the repo root:
#   cp .env.example .env
#
# LOCAL DEVELOPMENT ONLY. These are placeholder/dev defaults — never reuse
# them outside a throwaway local machine, and never commit a real `.env`.
# -----------------------------------------------------------------------------

# Bootstrap superuser created by the official `postgres` image.
POSTGRES_DB=wiseonline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_only
POSTGRES_PORT=5432

# Passwords for the two application-level roles created by
# docker/postgres/init/01-roles.sh (see AUTHENTICATION_PRD.md §5 Layer 3):
#   migrator  - owns the `public` schema, runs all migrations/DDL
#               (pnpm --filter api db:generate / db:migrate)
#   app_user  - NOBYPASSRLS, the API's runtime connection, owns nothing
# These must match the credentials embedded in apps/api/.env.example's
# DATABASE_URL / MIGRATION_DATABASE_URL.
MIGRATOR_PASSWORD=migrator_dev_only
APP_USER_PASSWORD=app_user_dev_only
